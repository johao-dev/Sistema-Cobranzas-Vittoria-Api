<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Genera el archivo XML con la documentacion de tipos y miembros
         para que Swashbuckle lo consuma y muestre los <summary> en Swagger UI.
         CS1591 (falta de comentario XML) se suprime para no obligar a
         documentar el codigo legacy preexistente; los archivos nuevos
         (Swagger/, Importacion/) si deben documentarse. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <DefaultItemExcludes>
      $(DefaultItemExcludes);
      .vs\**;
      bin\**;
      obj\**;
      wwwroot\uploads\**;
      **\.vs\**;
      **\bin\**;
      **\obj\**;
      **\wwwroot\uploads\**;
      Cobranzas_Vittoria.Tests\**
    </DefaultItemExcludes>
    <UserSecretsId>519a57a2-ceef-45e6-92c1-5934261c3f90</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cobranzas_Vittoria.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="dbup-core" Version="6.1.1" />
    <PackageReference Include="dbup-sqlserver" Version="7.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="NPOI" Version="2.7.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove=".vs\**" />
    <Content Remove="bin\**" />
    <Content Remove="obj\**" />
    <Content Remove="wwwroot\uploads\**" />

    <None Remove=".vs\**" />
    <None Remove="bin\**" />
    <None Remove="obj\**" />
    <None Remove="wwwroot\uploads\**" />

    <EmbeddedResource Remove=".vs\**" />
    <EmbeddedResource Remove="bin\**" />
    <EmbeddedResource Remove="obj\**" />
    <EmbeddedResource Remove="wwwroot\uploads\**" />

    <Compile Remove=".vs\**" />
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
    <Compile Remove="wwwroot\uploads\**" />
    <Compile Remove="Cobranzas_Vittoria.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\**\*.sql" />
  </ItemGroup>
</Project>